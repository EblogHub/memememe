generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum UniversityType {
  FEDERAL
  STATE
  PRIVATE
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED
}

enum ProductCategory {
  TEXTBOOKS
  ELECTRONICS
  FURNITURE
  FASHION
}

enum ProductCondition {
  NEW
  GENTLY_USED
  SCRATCHED
}

enum ProductStatus {
  AVAILABLE
  SOLD
}

model University {
  id               String   @id @default(uuid()) @db.Uuid
  fullName         String   @unique @map("full_name") @db.VarChar(160)
  shortCode        String   @unique @map("short_code") @db.VarChar(24)
  institutionType  UniversityType @map("institution_type")
  state            String   @db.VarChar(80)
  campusLocations  String[] @default([]) @map("campus_locations")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  students         User[]
  products         Product[]

  @@map("universities")
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  firstName         String        @map("first_name") @db.VarChar(50)
  lastName          String        @map("last_name") @db.VarChar(50)
  email             String        @unique @db.VarChar(254)
  passwordHash      String        @map("password_hash") @db.VarChar(100)
  phoneNumber       String        @map("phone_number") @db.VarChar(16)
  matricNumber      String        @unique @map("matric_number") @db.VarChar(40)
  level             Int
  idCardPhotoPath   String        @map("id_card_photo_path") @db.Text
  universityId      String        @map("university_id") @db.Uuid
  isVerified        Boolean       @default(false) @map("is_verified")
  agreedToTerms     Boolean       @default(false) @map("agreed_to_terms")
  accountStatus     AccountStatus @default(PENDING) @map("account_status")
  role              UserRole      @default(STUDENT)
  isBanned          Boolean       @default(false) @map("is_banned")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  university        University    @relation(fields: [universityId], references: [id], onDelete: Restrict)
  products          Product[]
  sessions          Session[]
  blacklistEntries  IdentityBlacklist[]
  adminEvents       AdminAuditEvent[] @relation("AdminActor")

  @@index([universityId, accountStatus])
  @@map("users")
}

model Product {
  id                  String           @id @default(uuid()) @db.Uuid
  title               String           @db.VarChar(120)
  description         String           @db.VarChar(2000)
  price               Decimal          @db.Decimal(12, 2)
  category            ProductCategory
  condition           ProductCondition
  imageUrls           String[]         @map("image_urls")
  sellerId            String           @map("seller_id") @db.Uuid
  targetUniversityId  String           @map("target_university_id") @db.Uuid
  campusLocation      String           @map("campus_location") @db.VarChar(160)
  status              ProductStatus    @default(AVAILABLE)
  isSold              Boolean          @default(false) @map("is_sold")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  seller              User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  targetUniversity    University       @relation(fields: [targetUniversityId], references: [id], onDelete: Restrict)

  @@index([targetUniversityId, status, createdAt(sort: Desc)])
  @@index([sellerId, status])
  @@map("products")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  userId      String   @map("user_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model IdentityBlacklist {
  id          String   @id @default(uuid()) @db.Uuid
  matricHash  String   @unique @map("matric_hash") @db.Char(64)
  userId      String?  @map("user_id") @db.Uuid
  reason      String   @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("identity_blacklist")
}

model AdminAuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  adminId     String   @map("admin_id") @db.Uuid
  action      String   @db.VarChar(80)
  targetId    String?  @map("target_id") @db.Uuid
  details     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  admin       User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("admin_audit_events")
}
